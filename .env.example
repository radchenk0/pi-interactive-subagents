# Per-agent model overrides for pi-interactive-subagents.
# Copy to .env and fill in. Real environment variables always win over .env.
#
# Every variable is optional. If none are set, subagents fall back to the
# default model of their backend (pi / Claude Code) session.
#
# PI_SUBAGENT_MODEL is the shared fallback for all agents; the
# PI_SUBAGENT_MODEL_<AGENT> variables override it per agent.

# Shared model for all pi-backed agents (provider/model, e.g. my-provider/my-model)
PI_SUBAGENT_MODEL=
# PI_SUBAGENT_MODEL_PI_WORKER=
# PI_SUBAGENT_MODEL_PLANNER=
# PI_SUBAGENT_MODEL_RESEARCHER=
# PI_SUBAGENT_MODEL_REVIEWER=
# PI_SUBAGENT_MODEL_TESTER=

# Model for the Claude Code-backed worker (claude --model value)
# PI_SUBAGENT_MODEL_WORKER_CLAUDE=
