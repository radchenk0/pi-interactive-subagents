# Optional environment configuration for pi-interactive-subagents.
# These are plain environment variables — export them in your shell profile,
# tmux/herdr pane env, or launcher. (The extension does not auto-load .env
# files; the real environment is what it sees.)
#
# Every variable is optional. Models are NOT configured here — pass the
# `model` (and optional `thinking`) parameter to the subagent tool per spawn.

# Mux backend override: herdr, cmux, tmux, zellij, wezterm
# (default: auto-detect from the environment)
# PI_SUBAGENT_MUX=

# Path to the herdr binary (default: `herdr` on PATH)
# HERDR_BIN_PATH=

# Extra delay (ms) after pane creation, before the first command is sent.
# Raise this if you see dropped commands behind slow shell init (direnv etc).
# PI_SUBAGENT_SHELL_READY_DELAY_MS=500

# How long (ms) a subagent may block on an ask_parent question before it
# times out and must proceed with its best assumption.
# PI_SUBAGENT_QUESTION_TIMEOUT_MS=600000

# tmux: rename the session/window of a subagent pane to its display name.
# PI_SUBAGENT_RENAME_TMUX_SESSION=1
# PI_SUBAGENT_RENAME_TMUX_WINDOW=1

# Pi config root for spawned sessions (default: ~/.pi/agent)
# PI_CODING_AGENT_DIR=
